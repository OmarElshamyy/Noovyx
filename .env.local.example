# Legacy Firebase configuration (preserved during staged migration & ETL backup)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
ADMIN_ACCESS_KEY=

# Supabase configuration (publishable + server-side secret key conventions)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side ONLY - NEVER prefix with NEXT_PUBLIC_ or expose to browser code
SUPABASE_SECRET_KEY=
# Feature flag for safe staged cutover ('supabase' | 'hybrid' | 'firebase')
NEXT_PUBLIC_DATA_BACKEND=supabase
# Optional local PostgreSQL URL for direct psql / pg migration scripts
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
